package com.ottersal.gestionbiblioteca.model;

import jakarta.persistence.*;
import java.time.LocalDate;
import com.ottersal.gestionbiblioteca.model.enums.StatusEnum; // Importa su enum real

@Entity
@Table(name = "reservations")
public class Reservation {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "usuario_id", nullable = false)
    private Long usuarioId; // Conecta con Client

    @Column(name = "book_id", nullable = false)
    private Long bookId; // Conecta con Book

    @Column(name = "fecha_reserva", nullable = false)
    private LocalDate fechaReserva;

    @Column(name = "fecha_expiracion", nullable = false)
    private LocalDate fechaExpiracion;

    @Enumerated(EnumType.STRING)
    @Column(nullable = false)
    private StatusEnum estado; // Usa el StatusEnum de su proyecto

    public Reservation() {}

    public Long getId() { return id; }
    public void setId(Long id) { this.id = id; }
    public Long getUsuarioId() { return usuarioId; }
    public void setUsuarioId(Long usuarioId) { this.usuarioId = usuarioId; }
    public Long getBookId() { return bookId; }
    public void setBookId(Long bookId) { this.bookId = bookId; }
    public LocalDate getFechaReserva() { return fechaReserva; }
    public void setFechaReserva(LocalDate fechaReserva) { this.fechaReserva = fechaReserva; }
    public LocalDate getFechaExpiracion() { return fechaExpiracion; }
    public void setFechaExpiracion(LocalDate fechaExpiracion) { this.fechaExpiracion = fechaExpiracion; }
    public StatusEnum getEstado() { return estado; }
    public void setEstado(StatusEnum estado) { this.estado = estado; }
}